# Copy to a protected, untracked environment file and replace keys before use.
# Internal: numeric private/loopback IP, explicit port, /v1; HTTP only on loopback.
RESEARCH_PLANNER_MODEL_PROVIDER=internal
RESEARCH_PLANNER_MODEL_BASE_URL=http://127.0.0.1:8091/v1
RESEARCH_PLANNER_MODEL_API_KEY=replace-with-separate-model-key
RESEARCH_PLANNER_SERVICE_API_KEY=replace-with-separate-service-key
RESEARCH_PLANNER_MODEL=Qwen/Qwen3-4B-Instruct-2507
RESEARCH_PLANNER_TIMEOUT_SECONDS=8
RESEARCH_PLANNER_MAX_TOKENS=1200
RESEARCH_PLANNER_OUTPUT_MODE=json_schema
RESEARCH_PLANNER_MAX_CONCURRENT_REQUESTS=2

# Groq alternative: replace the provider, base URL, model key and model above.
# Never give either key to a browser. These are placeholders, not credentials.
# RESEARCH_PLANNER_MODEL_PROVIDER=groq
# RESEARCH_PLANNER_MODEL_BASE_URL=https://api.groq.com/openai/v1
# RESEARCH_PLANNER_MODEL_API_KEY=gsk_example_redacted
# RESEARCH_PLANNER_MODEL=openai/gpt-oss-20b

# Recommended production candidate: OpenAI Terra with research-planner-v4 (37/37).
# Replace the corresponding values above; the internal defaults remain unchanged.
# RESEARCH_PLANNER_MODEL_PROVIDER=openai
# RESEARCH_PLANNER_MODEL_BASE_URL=https://api.openai.com/v1
# RESEARCH_PLANNER_MODEL_API_KEY=sk_example_redacted
# RESEARCH_PLANNER_MODEL=gpt-5.6-terra
# RESEARCH_PLANNER_TIMEOUT_SECONDS=30
# RESEARCH_PLANNER_MAX_TOKENS=1200
# RESEARCH_PLANNER_OUTPUT_MODE=json_schema
# RESEARCH_PLANNER_MAX_CONCURRENT_REQUESTS=2

# Deprecated: RESEARCH_PLANNER_MODEL_URL accepts only the old internal origin,
# without /v1. Do not set it together with MODEL_BASE_URL or with provider=groq/openai.
